  <RecipeDef ParentName="HeavyMechanoidRecipe">
    <defName>SNS_Bull</defName>
    <label>Gestate bull</label>
    <description>Gestate a bull mechanoid.</description>
    <researchPrerequisite>SNS_Research_II_Mechanoid</researchPrerequisite>
    <ingredients Inherit="False">
      <li>
        <filter>
          <thingDefs>
            <li>SNS_Unobtainium</li>
          </thingDefs>
        </filter>
        <count>150</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Plasteel</li>
          </thingDefs>
        </filter>
        <count>75</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentSpacer</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>SubcoreRegular</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <products>
      <SNS_Bull>1</SNS_Bull>
    </products>
    <descriptionHyperlinks>
      <ThingDef>SNS_Bull</ThingDef>
    </descriptionHyperlinks>
  </RecipeDef>


