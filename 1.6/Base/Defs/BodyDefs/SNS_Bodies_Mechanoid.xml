<?xml version="1.0" encoding="utf-8" ?>

<!--
	Each coverage value is relative to its parent.
	Remaining body part coverage (100% minus coverage of all child nodes) is a chance to hit exactly this part.
	Damage "starts" at corePart, and then "goes deeper" until it hits remaining body part coverage or leaf node - this body part is then hit.
-->

<Defs>
	
	<!-- Maul -->
	<BodyDef>
		<defName>SNS_MechBull</defName>
		<label>Mechanoid Bull</label>
		<corePart>
			<def>StarsteelMechFrame</def>
			<height>Middle</height>
			<depth>Outside</depth>
			<parts>
				<li>
					<def>StarsteelMechShell</def>
					<coverage>0.90</coverage>
					<height>Top</height>
				</li>
				<li>
					<def>MatterManipulator</def>
					<coverage>0.01</coverage>
					<height>Top</height>
				</li>
				<li>
					<def>StarsteelCore</def>
					<coverage>0.05</coverage>
					<height>Top</height>
					<parts>
						<li>
							<def>StarsteelMotionCore</def>
							<coverage>0.2</coverage>
							<depth>Inside</depth>
